# DigiLog 360 — Admin web environment
# Copy to `.env.local` and fill from your Supabase project settings (API section).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, server-side only (no NEXT_PUBLIC_ prefix). Email delivery actually
# runs in the Supabase edge functions (set via `supabase secrets set`); these
# are mirrored here so Vercel env imports carry them.
# RESEND_API_KEY=
# EMAIL_FROM=DigiLog 360 <alerts@your-verified-domain>

# Where the public enquiry form on /answers delivers. REQUIRED for that form to
# work — without it (or without RESEND_API_KEY above) the form tells the visitor
# it is not accepting messages rather than silently dropping them.
# CONTACT_TO=sales@your-domain
