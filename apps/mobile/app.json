{
  "expo": {
    "name": "DigiLog 360",
    "slug": "digilog360",
    "scheme": "digilog360",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/f17ce8b8-9260-4cc4-bf90-1acadce68707"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#0b1020",
      "resizeMode": "cover"
    },
    "assetBundlePatterns": [
      "**/*",
      "!**/*.psd",
      "!**/*.ai",
      "!**/*.sketch"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.netstream.digilog360",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan checkpoint QR codes and capture incident photos.",
        "NSLocationWhenInUseUsageDescription": "Verify your presence at patrol checkpoints.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track patrol routes in the background.",
        "NSMicrophoneUsageDescription": "Record voice notes for incidents.",
        "NFCReaderUsageDescription": "Tap NFC checkpoint tags to log your patrol.",
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "location",
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.netstream.digilog360",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1426"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "NFC",
        "VIBRATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.NFC"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": {
            "scheme": "digilog360"
          },
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        },
        {
          "action": "android.intent.action.VIEW",
          "data": {
            "scheme": "digilog360"
          },
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DigiLog to scan checkpoints and capture photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DigiLog to verify checkpoint presence.",
          "locationAlwaysAndWhenInUsePermission": "Allow DigiLog to track patrol routes."
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow DigiLog to read NFC checkpoint tags."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#667eea",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f17ce8b8-9260-4cc4-bf90-1acadce68707"
      }
    },
    "owner": "netstream"
  }
}
