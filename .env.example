# ============================================================================
# DigiLog 360 — repo-root environment
# Used by scripts/seed-accounts.mjs and supabase CLI deploys.
# Copy this file to `.env` and fill in the values from the Supabase dashboard.
# Never commit `.env` (it is gitignored).
# ============================================================================

# Supabase project URL — looks like https://<ref>.supabase.co
SUPABASE_URL=

# Service role key (Settings → API → service_role).
# This key bypasses RLS — keep it server-side ONLY.
# Never bundle it into the admin or mobile app.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: override the default temporary password for scripts/seed-new.mjs
# (used only when migrating legacy AspNetUsers accounts).
# SEED_PASSWORD=Digilog#2026

# Resend email alerts (task-alerts / send-email edge functions).
# These take effect as SUPABASE FUNCTION SECRETS, not from this file:
#   npx supabase secrets set RESEND_API_KEY=... "EMAIL_FROM=DigiLog 360 <alerts@your-verified-domain>"
# Until a domain is verified at resend.com/domains, use
# "DigiLog 360 <onboarding@resend.dev>" (delivers only to the Resend account owner).
RESEND_API_KEY=
EMAIL_FROM=
